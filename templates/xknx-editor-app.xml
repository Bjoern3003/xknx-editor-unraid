<Container version="2">
  <Name>XKNX-Editor</Name>
  <Icon>https://raw.githubusercontent.com/Bjoern3003/xknx-editor-unraid/main/xknx-logo.png</Icon>
  <Repository>ghcr.io/xknx/xknx-editor-web:latest</Repository>
  <Registry>https://github.com/orgs/XKNX/packages</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/XKNX/xknx-editor/issues</Support>
  <Project>https://github.com/XKNX/xknx-editor</Project>
  <Overview>Web-based KNX project editor</Overview>
  <Category>HomeAutomation: Tools</Category>
  <WebUI>http://[IP]:[PORT:8080]/</WebUI>
  <ExtraParams/>
  <PostArgs/>
  <CPUset/>
  <DonateText/>
  <DonateLink/>
  <Requires/>
  <Config Name="Web UI Port" Target="8080" Default="8080" Mode="tcp" Type="Port" Display="always" Required="true" Mask="false">8080</Config>
  <Config Name="Data & Settings" Target="/data" Default="/mnt/user/appdata/xknx-editor/data" Mode="rw" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/xknx-editor/data</Config>
  <Config Name="KNX-Projects" Target="/projects" Default="/mnt/user/appdata/xknx-editor/projects" Mode="rw" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/xknx-editor/projects</Config>
  <Config Name="Web-Password" Target="XKNX_WEB_PASSWORD" Default="" Mode="" Type="Variable" Display="always" Required="true" Mask="true"/>
</Container>
